# Copiado para .env por `npm run setup` (que também gera a DJANGO_SECRET_KEY).
# Fica na RAIZ: o backend (python-decouple) e o frontend (Vite) leem daqui.

# Ambiente: development | production. Decide o DEBUG E qual settings carrega (config/environment.py).
# production exige DJANGO_SECRET_KEY (32+ caracteres), API_URL https, POSTGRES_DB/USER/PASSWORD/HOST e REDIS_URL.
DJANGO_ENV=development
DJANGO_SECRET_KEY=troque-por-uma-chave-longa
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8001
FRONTEND_URL=http://localhost:5173
# Origem pública da API, sem /api no final. Vazio = mesma origem de FRONTEND_URL.
# Em desenvolvimento com Dev Tunnel, use a URL HTTPS pública que encaminha /api.
API_URL=

# Banco: sem POSTGRES_DB usa SQLite local (só em development; production recusa subir)
POSTGRES_DB=
POSTGRES_USER=starrp
POSTGRES_PASSWORD=starrp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis: sem ele, cache/canais/Celery rodam em memória (só development; production recusa subir)
REDIS_URL=
# Produção: pool de conexões do Postgres por processo (workers × POSTGRES_POOL_MAX < max_connections)
# POSTGRES_POOL_MIN=2
# POSTGRES_POOL_MAX=10

# Fiscal: Comunicador Fiscal ACBr em NUVEM (Docker, ACBR_MODO=nuvem — deploy/acbr/).
# Só o backend chama (PDV web e cancelamentos); o PDV desktop usa o Comunicador Fiscal desktop.
# Os três valores são os do .env do comunicador. Sem eles, o PDV web não emite.
ACBRLIB_URL=
ACBRLIB_TOKEN=
ACBR_E2E_KEY=
ACBRLIB_TIMEOUT=60

# Sincronização loja⇄nuvem: LOCAL | CLOUD (vazio = desligada)
SYNC_NODE_TYPE=
SYNC_ENVIRONMENT=development

# Cosmos (assistente de IA): chave da API da OpenAI. Vazio = Cosmos desligada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_LIGHT=gpt-5-nano
OPENAI_MODEL_HEAVY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Raciocínio dos modelos gpt-5/o-series: minimal | low | medium | high (low = mais rápido e barato).
OPENAI_REASONING_EFFORT=low
COSMOS_MAX_OUTPUT_TOKENS=4000
COSMOS_HISTORY_TURNS=8
# Mensagens por minuto por usuário na Cosmos. 0 = sem limite (usuário logado não tem limite).
COSMOS_MESSAGES_PER_MINUTE=0

# Precificação: fontes com cadastro (pesquisa da equipe e Open Prices não precisam de chave)
# serpapi.com e cosmos.bluesoft.com.br. Chaves globais: a conta com chave própria (admin do Django)
# ignora estas. Tetos = consultas por dia com a chave global, somando todas as contas.
SERPAPI_KEY=
BLUESOFT_COSMOS_TOKEN=
PRICE_SERPAPI_DAILY=8
PRICE_COSMOS_DAILY=20
# Fonte "Google Shopping": a ferramenta própria (projeto search-shop). SHOPPING_SEARCH_TOKEN é o API_TOKEN dela.
SHOPPING_SEARCH_URL=
SHOPPING_SEARCH_TOKEN=
PRICE_SHOPPING_SEARCH_DAILY=500
# Fonte "Bright Data": a chave da API e o nome da zona da SERP API (brightdata.com).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
PRICE_BRIGHTDATA_DAILY=100
PRICE_TRACKING_BATCH=200
# Rodadas no worker (precificação e SEO): itens por lote e segundos de pausa entre os lotes.
PRICE_BATCH_SIZE=10
PRICE_BATCH_PAUSE=30

# Analítico de SEO: volume de busca pelo Google Ads. Sem isto, a análise roda só com as regras.
# A conta pode ter credenciais próprias (admin do Django). Developer token só em projeto antigo.
GOOGLE_ADS_API_VERSION=v26
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# E-mail (redefinição de senha). Sem EMAIL_HOST o e-mail sai no terminal em desenvolvimento e não é enviado em produção. Porta 587 = STARTTLS; 465 = SSL.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=Starrp <no-reply@suaempresa.com.br>

# Frontend (Vite): para onde o dev server encaminha /api
VITE_API_TARGET=http://localhost:8001

# Produção: erros no Sentry (vazio = desligado) e HSTS (segundos; 0 desliga)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SECURE_HSTS_SECONDS=31536000

# Produção: use docker/ (docker/.env.example). As linhas abaixo são só da opção antiga com Caddy
# (deploy/production/docker-compose.yml): o Caddy serve o app e a API na MESMA origem, em HTTPS
# (certificado automático do Let's Encrypt para este domínio; http redireciona para https).
# FRONTEND_URL, DJANGO_CORS_ALLOWED_ORIGINS e DJANGO_CSRF_TRUSTED_ORIGINS precisam ser https:// (o
# production.py recusa subir com http: o cookie de login é Secure e não trafega sem HTTPS).
# SITE_ADDRESS=app.suaempresa.com.br
# Cookie de login: httpOnly + Secure sempre em produção; SameSite Strict (padrão) com app e API no
# mesmo domínio. Lax/None só se o app ficar em outro domínio que a API.
# AUTH_COOKIE_SAMESITE=Strict
