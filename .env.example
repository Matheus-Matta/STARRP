# Copiado para .env por `npm run setup` (que também gera a DJANGO_SECRET_KEY).
# Fica na RAIZ: o backend (python-decouple) e o frontend (Vite) leem daqui.

# Ambiente: development | production (única chave que decide o DEBUG)
DJANGO_ENV=development
DJANGO_SECRET_KEY=troque-por-uma-chave-longa
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Banco: sem POSTGRES_DB usa SQLite local (desenvolvimento)
POSTGRES_DB=
POSTGRES_USER=starrp
POSTGRES_PASSWORD=starrp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis: sem ele, cache/canais/Celery rodam em memória (desenvolvimento)
REDIS_URL=

# Fiscal: comunicador ACBrLib desta instalação
ACBRLIB_URL=
ACBRLIB_TOKEN=

# Sincronização loja⇄nuvem: LOCAL | CLOUD (vazio = desligada)
SYNC_NODE_TYPE=
SYNC_ENVIRONMENT=development

# Cosmos (assistente de IA): chave da API da OpenAI. Vazio = Cosmos desligada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_LIGHT=gpt-5-nano
OPENAI_MODEL_HEAVY=
# Raciocínio dos modelos gpt-5/o-series: minimal | low | medium | high (low = mais rápido e barato).
OPENAI_REASONING_EFFORT=low
COSMOS_MAX_OUTPUT_TOKENS=4000
COSMOS_HISTORY_TURNS=8

# Precificação: fontes com cadastro (pesquisa da equipe e Open Prices não precisam de chave)
# serpapi.com e cosmos.bluesoft.com.br. Chaves globais: a conta com chave própria (admin do Django)
# ignora estas. Tetos = consultas por dia com a chave global, somando todas as contas.
SERPAPI_KEY=
BLUESOFT_COSMOS_TOKEN=
PRICE_SERPAPI_DAILY=8
PRICE_COSMOS_DAILY=20
# Fonte "Google Shopping": a ferramenta própria (projeto search-shop). SHOPPING_SEARCH_TOKEN é o API_TOKEN dela.
SHOPPING_SEARCH_URL=
SHOPPING_SEARCH_TOKEN=
PRICE_SHOPPING_SEARCH_DAILY=500
# Fonte "Bright Data": a chave da API e o nome da zona da SERP API (brightdata.com).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
PRICE_BRIGHTDATA_DAILY=100
PRICE_TRACKING_BATCH=200
# Rodadas no worker (precificação e SEO): itens por lote e segundos de pausa entre os lotes.
PRICE_BATCH_SIZE=10
PRICE_BATCH_PAUSE=30

# Analítico de SEO: volume de busca pelo Google Ads. Sem isto, a análise roda só com as regras.
# A conta pode ter credenciais próprias (admin do Django). Developer token só em projeto antigo.
GOOGLE_ADS_API_VERSION=v26
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Frontend (Vite): para onde o dev server encaminha /api
VITE_API_TARGET=http://localhost:8000
