# Copie para .env (ao lado do docker-compose.yml). UM .env para todos os containers: backend (blue e green),
# worker, beat, migrate, Postgres e o Comunicador Fiscal ACBr. Nunca commite o .env.

# ── Versões das imagens (publicadas pelos workflows: tags backend-vX.Y.Z / frontend-vX.Y.Z) ─────────────
# Sempre uma versão fixa (S-16): `latest` mudaria o que roda sem ninguém decidir.
BACKEND_VERSION=1.0.0
# Só durante a troca (deploy-backend.sh preenche sozinho); vazio = mesma do BACKEND_VERSION.
BACKEND_GREEN_VERSION=
FRONTEND_VERSION=1.0.0
# Versão publicada do comunicador fiscal (obrigatória; latest mudaria sem aviso).
ACBR_VERSAO=

# ── nginx (portas do SERVIDOR; dentro do container ele ouve sempre 80 e 443) ────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Porta HTTPS que o navegador usa, para o redirecionamento http → https. Atrás da Cloudflare é sempre 443
# (mesmo com NGINX_HTTPS_PORT diferente: a Cloudflare fala com o servidor na porta configurada nela).
# Sem Cloudflare, igual ao NGINX_HTTPS_PORT.
NGINX_PUBLIC_HTTPS_PORT=443
# Só a Cloudflare conecta no servidor (Authenticated Origin Pulls). LIGUE também na Cloudflare: SSL/TLS →
# Origin Server → Authenticated Origin Pulls = On. Sem Cloudflare na frente: off.
NGINX_CF_ORIGIN_PULL=on

# ── Django ──────────────────────────────────────────────────────────────────────────────────────────
DJANGO_ENV=production
# 64 caracteres:   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.suaempresa.com.br
# Tudo https:// (o backend recusa subir com http em produção).
FRONTEND_URL=https://app.suaempresa.com.br
DJANGO_CORS_ALLOWED_ORIGINS=https://app.suaempresa.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.suaempresa.com.br
API_URL=
# Servidor da API: uvicorn assíncrono. Processos POR backend (blue e green): ~ núcleos do servidor ÷ 2.
# Cada processo atende muitas requisições ao mesmo tempo (não enfileira). Conta do Postgres:
# (2 backends × WEB_CONCURRENCY + worker) × POSTGRES_POOL_MAX < max_connections (100).
WEB_CONCURRENCY=3
# Máx. de conexões simultâneas por processo: acima disso responde 503 na hora em vez de deixar na fila
# (GET o nginx tenta no outro backend; POST volta 503). Conta as conexões abertas do nginx: 200+. 0 = sem limite.
UVICORN_LIMIT=0
CELERY_CONCURRENCY=2

# Chave da cifra dos segredos no banco (CSC, senha do certificado A1, tokens de integração). Obrigatória.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde junto do backup do banco: sem ela os segredos não abrem.
FIELD_ENCRYPTION_KEY=

# E-mail (redefinição de senha). Sem EMAIL_HOST nada é enviado em produção. Porta 587 = STARTTLS; 465 = SSL.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=Starrp <no-reply@suaempresa.com.br>

# ── Postgres (o container do banco e o backend leem os mesmos) ─────────────────────────────────────────
POSTGRES_DB=starrp
POSTGRES_USER=starrp
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=8

# ── Comunicador Fiscal ACBr (rede interna; o compose já aponta ACBRLIB_URL para http://acbr:8030) ─────────
# Token (32+ caracteres):   openssl rand -base64 48 | tr -d '\n/+='; echo
ACBRLIB_TOKEN=
# Cifra de ponta a ponta (32 bytes em base64, diferente do token):   openssl rand -base64 32
ACBR_E2E_KEY=
ACBRLIB_TIMEOUT=60
# 1 = SEFAZ simulada. NUNCA em produção.
ACBR_SIMULADOR=0
ACBR_ALLOWED_ORIGINS=

# ── Backup (docker/backup/) ─────────────────────────────────────────────────────────────────────────
# Banco + fotos + certificados, cifrados aqui e enviados a QUALQUER S3: AWS, MinIO, Backblaze B2, Cloudflare R2,
# Wasabi. Endpoint vazio = AWS. Ex.: MinIO https://minio.suaempresa.com.br · B2 https://s3.us-west-004.backblazeb2.com
# · R2 https://<conta>.r2.cloudflarestorage.com (região "auto"). Use um bucket só para isto, de OUTRO servidor.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=starrp
# path (MinIO e a maioria) ou virtual (AWS aceita os dois)
BACKUP_S3_ADDRESSING=path
# Chave com permissão SÓ neste bucket (listar, gravar e apagar).
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Senha da cifra (20+ caracteres). Sem ela o backup NÃO abre: guarde fora do servidor, com a FIELD_ENCRYPTION_KEY.
#   openssl rand -base64 36
BACKUP_PASSPHRASE=
# Horário (cron, no fuso TZ) e quantos dias guardar (0 = todas).
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=30
# 1 = faz uma cópia logo ao subir (bom para conferir a configuração).
BACKUP_ON_START=0
TZ=America/Sao_Paulo

# ── Integrações (vazias = desligadas) ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
SERPAPI_KEY=
BLUESOFT_COSMOS_TOKEN=
SHOPPING_SEARCH_URL=
SHOPPING_SEARCH_TOKEN=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ── Monitoramento ──────────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SECURE_HSTS_SECONDS=31536000
