# Copie para .env (ao lado do docker-compose.yml). Os mesmos valores vão no .env do backend.

# Token (32+ caracteres):   openssl rand -base64 48 | tr -d '\n/+='; echo
ACBRLIB_TOKEN=
# Cifra de ponta a ponta (32 bytes em base64, diferente do token):   openssl rand -base64 32
ACBR_E2E_KEY=

# 1 = SEFAZ simulada (desenvolvimento). NUNCA em produção.
ACBR_SIMULADOR=0

# O backend chama sem navegador: nenhuma origem precisa ser liberada.
ACBR_ALLOWED_ORIGINS=
