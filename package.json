{
  "name": "starrp",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Starrp ERP — comandos do monorepo (backend Django + frontend Vue + desktop + app móvel).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:demo": "node scripts/setup.mjs --demo",
    "dev": "node scripts/dev.mjs",
    "backend": "node scripts/dev.mjs backend",
    "frontend": "node scripts/dev.mjs frontend",
    "desktop": "npm --prefix desktop run dev",
    "desktop:install": "npm --prefix desktop install",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:dist": "npm --prefix desktop run dist",
    "mobile": "npm --prefix mobile run start",
    "mobile:tunnel": "npm --prefix mobile run tunnel",
    "mobile:check": "npm --prefix mobile run check:build --",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:install": "npm --prefix mobile install",
    "test": "node scripts/tasks.mjs test",
    "test:migrations": "node scripts/tasks.mjs test:migrations",
    "lint": "node scripts/tasks.mjs lint",
    "build": "node scripts/tasks.mjs build",
    "api:types": "node scripts/tasks.mjs api:types",
    "migrate": "node scripts/tasks.mjs migrate",
    "makemigrations": "node scripts/tasks.mjs makemigrations",
    "manage": "node scripts/tasks.mjs manage",
    "account": "node scripts/tasks.mjs account"
  }
}
